# Chave secreta usada para as sessões do Flask
SECRET_KEY=COLOQUE_UMA_CHAVE_LONGA_E_ALEATORIA

# Caminho do arquivo Excel usado como armazenamento local.
# Em Windows, pode ser um caminho completo.
# Em ambiente de servidor, use um armazenamento persistente compatível com o ambiente.
EXCEL_DATABASE=sp_aguas.xlsx
SQLITE_DATABASE=sp_aguas.db
